meta {
  name: Get Client Site (Include Service Account)
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/v1/clients/acme-corp/sites/00000000-0000-0000-0000-000000000000?include=googleServiceAccount
  body: none
  auth: none
}

headers {
  X-API-Key: {{apiKey}}
}

docs {
  googleServiceAccount is gated at the join level — the base request above
  never touches google_service_accounts at all, this one does only when
  ?include=googleServiceAccount is present.
}
