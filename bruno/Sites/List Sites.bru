meta {
  name: List Sites
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/v1/sites?active=true
  body: none
  auth: none
}

headers {
  X-API-Key: {{apiKey}}
}

docs {
  Flat, cross-tenant — every client's sites in one response. The active
  query param is optional; remove it to stop filtering. (The old
  analyticsReportEnabled filter went with sites.analytics_* in SOL-35 —
  scheduled reports live on analytics_reports now.) Never
  includes credentials, not even the service account email — there is no
  ?include= on this route.
}
