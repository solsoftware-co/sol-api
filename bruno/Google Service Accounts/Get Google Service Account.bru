meta {
  name: Get Google Service Account
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/clients/{{clientId}}/google-service-accounts/00000000-0000-0000-0000-000000000000
  body: none
  auth: none
}

headers {
  X-API-Key: {{apiKey}}
}

docs {
  One of the client's service accounts, without its private key. Another
  client's service account is a 404.
}
