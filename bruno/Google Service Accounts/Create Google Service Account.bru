meta {
  name: Create Google Service Account
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/clients/{{clientId}}/google-service-accounts
  body: json
  auth: none
}

headers {
  X-API-Key: {{apiKey}}
}

body:json {
  {
    "name": "Sheets writer",
    "description": "Writes form submissions to Google Sheets",
    "email": "writer@your-project.iam.gserviceaccount.com",
    "key": "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
  }
}

docs {
  Creates a Google service account for the client (SOL-50). The key is
  write-only: stored, never returned by these routes. Use the returned id as
  googleServiceAccountId when creating a Google Sheets integration.

  201 responds with { id, clientId, name, description, email, createdAt,
  updatedAt }. 404 if the client doesn't exist; 422 for an invalid body.
}
