meta {
  name: Create Notification Log (Email)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/notification-logs
  body: json
  auth: none
}

headers {
  X-API-Key: {{apiKey}}
}

body:json {
  {
    "clientId": "acme-corp",
    "workflow": "weekly-report",
    "eventName": "report_sent",
    "outcome": "sent",
    "type": "email",
    "recipientEmail": "contact@acme.com",
    "subject": "Your weekly report",
    "resendId": null,
    "errorMessage": null,
    "metadata": {}
  }
}
